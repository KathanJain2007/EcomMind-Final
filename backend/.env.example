# Copy to backend/.env and fill in. Never commit the real .env.

# Long random string used to sign receipts and protect sessions.
SECRET_KEY=change-me-to-a-long-random-string

# SQLite file (relative to backend/). Created on first start.
DATABASE_URL=sqlite:///./ecommind.db

# Allowed browser origin for the Vite dev server.
FRONTEND_ORIGIN=http://localhost:3000

# Set to true when serving over HTTPS so session cookies are Secure.
COOKIE_SECURE=false

# Google Places (New) API key — server-side only. Leave empty to disable
# autocomplete; the location field then falls back to manual entry.
GOOGLE_MAPS_API_KEY=
# Restrict suggestions to these ISO country codes (comma-separated).
PLACES_REGION_CODES=in
# true = onboarding requires a location picked from Google suggestions.
LOCATION_VERIFICATION_REQUIRED=false

# Email verification: off | optional | required
EMAIL_VERIFICATION=optional
# SMTP settings. If SMTP_HOST is empty no email is ever sent and the app
# says so instead of pretending a code went out.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Seconds before a service-agent execution is treated as timed out.
AGENT_TIMEOUT_SECONDS=10
